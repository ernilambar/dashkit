{
  "name": "ernilambar/dashkit",
  "description": "Reusable widget engine for WordPress admin pages.",
  "license": "GPL-2.0-or-later",
  "type": "library",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "ernilambar/coding-standard": "^2.0",
    "php-parallel-lint/php-parallel-lint": "dev-develop#f8cb90a",
    "slevomat/coding-standard": "^8.22",
    "wp-cli/wp-cli": "^3.0",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Nilambar\\Dashkit\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "format": "@php ./vendor/bin/phpcbf --report-full --report-summary",
    "lint": [
      "@lint-php",
      "@phpcs"
    ],
    "lint-php": "@php ./vendor/bin/parallel-lint --colors --exclude .git --exclude vendor .",
    "phpcs": "@php ./vendor/bin/phpcs --report-full --report-summary"
  }
}
